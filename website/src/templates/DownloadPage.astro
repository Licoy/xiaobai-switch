---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import { GITHUB_LATEST_RELEASE_URL, type Locale } from "../lib/site";
import { loadLatestRelease, type AssetKind } from "../lib/releases";
import UiIcon from "../components/UiIcon.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const seo = t(locale, "seo");
const download = t(locale, "download");
const latest = await loadLatestRelease(process.env.GITHUB_TOKEN, process.env.RELEASE_TAG);
const assets = latest?.assets ?? {};
const releaseUrl = latest?.tag
  ? `https://github.com/Licoy/xiaobai-switch/releases/tag/${encodeURIComponent(latest.tag)}`
  : GITHUB_LATEST_RELEASE_URL;
const labels: Partial<Record<AssetKind, string>> = {
  "mac-arm": download.ctaDmg, "mac-intel": download.ctaDmg,
  "win-x64-msi": download.ctaMsi, "win-x64-nsis": download.ctaNsis,
  "win-arm-nsis": download.ctaNsis, "win-x64-zip": download.ctaZip,
  "win-arm-zip": download.ctaZip, "linux-x64": download.ctaTar, "linux-arm": download.ctaTar,
};
const platforms = [
  { id: "macos", label: download.tabMacos, icon: "tabler:brand-apple", cards: [
    { title: download.macArm, hint: download.macArmHint, kinds: ["mac-arm"] },
    { title: download.macIntel, hint: download.macIntelHint, kinds: ["mac-intel"] },
  ] },
  { id: "windows", label: download.tabWindows, icon: "tabler:brand-windows", cards: [
    { title: download.winX64, hint: download.winX64Hint, kinds: ["win-x64-nsis", "win-x64-msi", "win-x64-zip"] },
    { title: download.winArm, hint: download.winArmHint, kinds: ["win-arm-nsis", "win-arm-zip"] },
  ] },
  { id: "linux", label: download.tabLinux, icon: "remix:terminal-line", cards: [
    { title: download.linuxX64, hint: download.linuxHint, kinds: ["linux-x64"] },
    { title: download.linuxArm, hint: download.linuxHint, kinds: ["linux-arm"] },
  ] },
];
---
<BaseLayout locale={locale} title={seo.downloadTitle} description={seo.downloadDescription} slug="download">
  <div class="page-wrap py-12" data-download-root>
    <h1 class="text-4xl font-bold">{download.title}</h1>
    <p class="mt-3 max-w-3xl text-lg opacity-80">{download.subtitle}</p>
    <p class="mt-2 opacity-70">{download.platforms}</p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a class="btn btn-outline" href={releaseUrl} target="_blank" rel="noopener noreferrer">
        <UiIcon name="lucide:github" />{download.latest}
      </a>
      {latest?.tag && <p class="text-sm opacity-70">{download.latestVersion} <span class="font-mono">{latest.tag}</span></p>}
    </div>
    <p class="mt-3 text-sm opacity-60">{download.detectHint}</p>
    <div role="tablist" aria-label={download.title} class="tabs tabs-box mt-8 w-fit">
      {platforms.map((platform, index) => <button type="button" role="tab"
        id={`os-tab-${platform.id}`} class:list={["tab gap-2", { "tab-active": index === 0 }]}
        data-os-tab={platform.id} aria-controls={`os-panel-${platform.id}`}
        aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>
        <UiIcon name={platform.icon} />{platform.label}
      </button>)}
    </div>
    {platforms.map((platform, index) => <section id={`os-panel-${platform.id}`} role="tabpanel"
      aria-labelledby={`os-tab-${platform.id}`} data-os-panel={platform.id} hidden={index !== 0} tabindex="0">
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {platform.cards.map((card) => {
          const available = (card.kinds as AssetKind[]).filter((kind) => assets[kind]);
          return <article class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body">
            <h2 class="card-title"><UiIcon name={platform.icon} class="size-6" />{card.title}</h2>
            <p class="opacity-70">{card.hint}</p>
            <div class="card-actions mt-2 flex-wrap items-center gap-2">
              {available.map((kind, assetIndex) => <a class:list={["btn", assetIndex === 0 ? "btn-primary" : "btn-outline"]}
                href={assets[kind]!.url} title={assets[kind]!.name} target="_blank" rel="noopener noreferrer">
                <UiIcon name="lucide:download" />{labels[kind]}
              </a>)}
              {available.length === 0 && <p role="status">{download.unavailable}</p>}
            </div>
          </div></article>;
        })}
      </div>
      {platform.id === "macos" && <p class="mt-6">{download.macRequirement} <a class="link" href="https://github.com/Licoy/xiaobai-switch/releases/tag/v0.0.12">{download.macLegacy}</a></p>}
      {platform.id === "linux" && <p class="mt-6">{download.linuxRequirements}</p>}
      {platform.id === "windows" && <p class="mt-6">{download.windowsRequirements}</p>}
    </section>)}
    <p class="mt-8 text-sm opacity-70">{download.migration}</p>
  </div>
</BaseLayout>
<script>
  const root = document.querySelector<HTMLElement>("[data-download-root]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-os-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-os-panel]")];
    function select(index: number, focus = false) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.classList.toggle("tab-active", i === index);
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      if (focus) tabs[index]?.focus();
    }
    const device = `${navigator.platform} ${navigator.userAgent}`;
    select(/Windows|Win32|Win64/i.test(device) ? 1 : /Linux/i.test(device) && !/Android/i.test(device) ? 2 : 0);
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const next = event.key === "ArrowRight" ? (index + 1) % tabs.length
          : event.key === "ArrowLeft" ? (index + tabs.length - 1) % tabs.length
          : event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : -1;
        if (next >= 0) { event.preventDefault(); select(next, true); }
      });
    });
  }
</script>
